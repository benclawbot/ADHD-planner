# Tempo Planner local development environment
# Copy this file to `.env` and fill in values. `.env` is gitignored — never commit secrets.

# Standalone root app (optional sync server)
PORT=4173

# Hosted Site sync Worker (Cloudflare)
# The 256-bit shared capability's SHA-256 digest (hex, 64 chars). Set this in the
# Worker environment; never store the raw capability here.
TEMPO_SHARED_KEY_SHA256=

# D1 database binding name used for local previews (see sites/tempo-planner/hosting.config.json)
# DB=DB
